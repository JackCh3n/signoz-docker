# =============================================================================
# SigNoz 部署参数（复制为 .env 后生效；install.sh 会自动复制）
# 修改后需重新执行 docker compose up -d 使配置生效
# =============================================================================

# ---- 组件版本（离线包与 compose 必须一致，升级时同步修改） ----
SIGNOZ_VERSION=v0.146.0
COLLECTOR_VERSION=v0.144.14
CLICKHOUSE_VERSION=25.12.5
POSTGRES_VERSION=16

# ---- 对外端口 ----
# UI / API
SIGNOZ_HTTP_PORT=8080
# OTLP gRPC（Java 应用推荐）
OTLP_GRPC_PORT=4317
# OTLP HTTP（/v1/traces、/v1/metrics、/v1/logs）
OTLP_HTTP_PORT=4318

# ---- PostgreSQL（仅容器网络内部使用，不对外暴露） ----
# 密码只建议使用字母、数字、下划线，避免 DSN 转义问题
# 注意：首次启动后再修改此密码不会同步修改数据库内已有口令
POSTGRES_USER=signoz
POSTGRES_PASSWORD=signoz
POSTGRES_DB=signoz

# ---- 可选：打包 Java Agent 时使用的版本（bundle.sh --with-java-agent） ----
OTEL_JAVAAGENT_VERSION=v2.32.0
