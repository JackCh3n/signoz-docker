# =============================================================================
# SigNoz 集群 / 多节点部署参数（复制为 .env.cluster 后生效）
#
# 适用：cluster 分支的 Docker Swarm 部署（cluster/README.md）
# 单机模式仍使用根目录的 .env.example / docker-compose.yaml
# =============================================================================

# ---- 组件版本（离线包与 stack 必须一致，升级时同步修改） ----
SIGNOZ_VERSION=v0.146.0
COLLECTOR_VERSION=v0.144.14
CLICKHOUSE_VERSION=25.12.5
POSTGRES_VERSION=16
HAPROXY_VERSION=2.9-alpine

# ---- 对外端口（通过 Swarm routing mesh 发布到所有节点） ----
SIGNOZ_HTTP_PORT=8080
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318

# ---- PostgreSQL（单实例；仅容器网络内部使用） ----
# 密码只建议使用字母、数字、下划线，避免 DSN 转义问题
# 首次部署后再修改此密码不会同步修改数据库内已有口令
POSTGRES_USER=signoz
POSTGRES_PASSWORD=signoz
POSTGRES_DB=signoz
